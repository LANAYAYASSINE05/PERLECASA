# Modèle de configuration pour la production — Perle Casa Immobilier
# Copier en .env sur le serveur puis compléter les valeurs vides.
# Ne jamais commiter le .env rempli. Générer la clé sur le serveur : php artisan key:generate

APP_NAME="Perle Casa Immobilier"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://perlecasa.com

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# Journaux quotidiens, conservés 14 jours, sans le bruit des niveaux debug et info
LOG_CHANNEL=daily
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=perla_casa
# Utilisateur dédié à l'application (pas root), droits limités à cette base
DB_USERNAME=
DB_PASSWORD=

# Session chiffrée, cookie envoyé uniquement en HTTPS, inaccessible au JavaScript
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_EXPIRE_ON_CLOSE=false
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="finance@perlecasa.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# Identité imprimée sur les factures, reçus et bons de commande
SOCIETE_NOM="Perle Casa Immobilier"
SOCIETE_FORME=SARL
SOCIETE_CAPITAL=100000
SOCIETE_ADRESSE=
SOCIETE_VILLE=Casablanca
SOCIETE_TELEPHONE=
SOCIETE_EMAIL=
SOCIETE_ICE=
SOCIETE_RC=
SOCIETE_IF=
SOCIETE_PATENTE=
SOCIETE_CNSS=
TVA_VENTE=20
ECHEANCE_JOURS=30

# Reverb : le serveur écoute en local, le proxy (Nginx/Apache) expose wss:// sur le port 443.
# Générer des clés propres à la production (php artisan reverb:install ou valeurs aléatoires longues).
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_SERVER_HOST=127.0.0.1
REVERB_SERVER_PORT=8080
REVERB_HOST=perlecasa.com
REVERB_PORT=443
REVERB_SCHEME=https

# Premier administrateur, créé une seule fois par installer.sh lors de la première installation.
# Mot de passe : 10 caractères minimum, majuscules, minuscules et chiffres.
# Une fois connecté, vider ADMIN_PASSWORD (le compte reste créé).
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Laisser vide en production : sinon des données de démonstration sont chargées.
DEMO_PASSWORD=
